# Copy this file to .env and fill in the real values.
# .env is git-ignored and never committed.
#
# GITHUB_TOKEN — Personal Access Token for github.ibm.com
#   Required scopes (fine-grained): Contents RW, Pull requests RW, Issues RW
#   Generate at: https://github.ibm.com/settings/tokens
GITHUB_TOKEN=<your-github-ibm-token>
